{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_code": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_role": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "placed",
        "confirmed",
        "fulfilled",
        "cancelled"
      ],
      "default": "placed"
    }
  },
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}