{
  "name": "PalmAnalysis",
  "type": "object",
  "properties": {
    "analysis_code": {
      "type": "string"
    },
    "palm_id": {
      "type": "string"
    },
    "palm_identifier": {
      "type": "string"
    },
    "farm_name": {
      "type": "string"
    },
    "image_uri": {
      "type": "string"
    },
    "health_score": {
      "type": "number"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "enumColors": [
        "green",
        "yellow",
        "red"
      ]
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary_ar": {
      "type": "string"
    },
    "summary_en": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai",
        "demo"
      ],
      "default": "demo",
      "enumColors": [
        "green",
        "gray"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}