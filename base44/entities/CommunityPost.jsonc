{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "post_code": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "knowledge",
        "need",
        "service",
        "opportunity",
        "partnership"
      ],
      "default": "knowledge",
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "pink"
      ]
    },
    "title": {
      "type": "string"
    },
    "title_en": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "body_en": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_name_en": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "farmer",
        "facility",
        "company",
        "investor",
        "specialist"
      ],
      "default": "farmer",
      "enumColors": [
        "green",
        "purple",
        "blue",
        "yellow",
        "gray"
      ]
    },
    "organization": {
      "type": "string"
    },
    "organization_en": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_discussion",
        "closed"
      ],
      "default": "open",
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ]
    },
    "interest_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}